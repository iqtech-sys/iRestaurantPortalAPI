<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ============================================== -->
    <!-- CONSOLE APPENDER (For INFO, WARN, etc.)        -->
    <!-- ============================================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!-- Log INFO, WARN, and ERROR to the console. 
             (Trace and Debug are ignored unless you change the root level) -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ============================================== -->
    <!-- FILE APPENDER (For ERROR only)                 -->
    <!-- ============================================== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/var/objectbox-sync/logs/error.log</file>
        
        <!-- Create the error.log file when it does not exist, otherwise append to it -->
        <append>true</append>

        <!-- Ensure missing parent directories are created automatically -->
        <createMissingDirectories>true</createMissingDirectories>

        <!-- Use a LevelFilter to ACCEPT only ERROR logs and DENY everything else -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <!-- Rolling Policy: defines how rolled files are named -->
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>/var/objectbox-sync/logs/error.%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>10</maxIndex>
        </rollingPolicy>

        <!-- Triggering Policy: triggers a rollover when the file reaches 10MB -->
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ============================================== -->
    <!-- ROOT LOGGER CONFIG                             -->
    <!-- ============================================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ERROR_FILE" />
    </root>

</configuration>
